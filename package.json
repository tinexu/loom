{
  "name": "loom-terminal",
  "productName": "Loom",
  "version": "0.1.0",
  "description": "A spatial, intelligent terminal: commands become cards on an infinite canvas.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/vendor.js",
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e.js",
    "bench": "node scripts/bench.js",
    "icons": "electron scripts/icons.js",
    "dist": "node scripts/dist.js",
    "check:package": "node scripts/check-package.js",
    "smoke:packaged": "node scripts/smoke-packaged.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@withfig/autocomplete": "^2.692.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "homepage": "https://github.com/tinexu/loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinexu/loom.git"
  },
  "bugs": {
    "url": "https://github.com/tinexu/loom/issues"
  },
  "author": {
    "name": "Loom contributors"
  }
}
